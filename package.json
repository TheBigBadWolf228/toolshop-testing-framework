{
  "name": "toolshop-testing-framework",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "test:ui": "playwright test --project=\"UI Chrome\" --project=\"UI Firefox\" --project=\"UI Safari\"",
    "test:api": "playwright test --project=\"API\"",
    "test:all": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=\"UI Chrome\" --project=\"API\"",
    "report:allure": "rm -rf allure-report && allure generate && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test:evals": "promptfoo eval -c evals/promptfooconfig.yaml",
    "test:evals:judge-calibration": "promptfoo eval -c evals/judge-calibration.yaml",
    "test:perf": "k6 run perf/products.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "prettier": "3.10.1",
    "promptfoo": "0.125.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
