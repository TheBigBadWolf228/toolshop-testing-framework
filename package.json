{
  "name": "toolshop-testing-framework",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:ui": "playwright test --project=\"UI Chrome\" --project=\"UI Firefox\" --project=\"UI Safari\"",
    "test:api": "playwright test --project=\"API\"",
    "test:all": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=\"UI Chrome\" --project=\"API\"",
    "report:allure": "rm -rf allure-report && allure generate && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
